// Simple KVRM program demonstrating basic variable declarations and arithmetic

let x: i32 = 10;
let y: i32 = 20;
let sum: i32 = x + y;

let product = x * y;
let difference = y - x;
let quotient = y / x;
let remainder = y % x;

// Boolean expressions
let is_positive = x > 0;
let is_equal = x == y;
let is_not_equal = x != y;

// Mutable variables
let mut counter = 0;
counter = counter + 1;
counter += 1;

// String literals
let greeting = "Hello, KVRM!";
let empty = "";

// Floating point numbers
let pi: f32 = 3.14;
let euler: f64 = 2.71828;

// Boolean values
let is_true = true;
let is_false = false;

// Different number formats
let hex = 0xFF;
let binary = 0b1010;
let octal = 0o777;
let large_number = 1_000_000;
