// Function declarations and calls

// Simple function with parameters and return type
fn add(a: i32, b: i32) -> i32 {
  return a + b;
}

// Function without return type
fn print_message() {
  let msg = "Hello from function";
}

// Function with multiple statements
fn calculate(x: i32, y: i32) -> i32 {
  let sum = x + y;
  let product = x * y;
  return sum + product;
}

// Recursive function
fn factorial(n: i32) -> i32 {
  if (n <= 1) {
    return 1;
  }
  return n * factorial(n - 1);
}

// Fibonacci sequence
fn fibonacci(n: i32) -> i32 {
  if (n <= 1) {
    return n;
  }
  return fibonacci(n - 1) + fibonacci(n - 2);
}

// Function with early return
fn abs(x: i32) -> i32 {
  if (x < 0) {
    return -x;
  }
  return x;
}

// Function with multiple parameters
fn max(a: i32, b: i32, c: i32) -> i32 {
  if (a > b && a > c) {
    return a;
  }
  if (b > c) {
    return b;
  }
  return c;
}

// Function calls
fn main() {
  let sum_result = add(10, 20);
  let fact_5 = factorial(5);
  let fib_10 = fibonacci(10);
  let absolute = abs(-42);
  let maximum = max(10, 20, 15);

  print_message();
}

// Generic function (if supported)
fn identity<T>(x: T) -> T {
  return x;
}

// Function with no parameters
fn get_constant() -> i32 {
  return 42;
}

// Function with mutable parameter
fn increment(mut x: i32) -> i32 {
  x = x + 1;
  return x;
}

// Function with multiple return paths
fn classify_number(x: i32) -> i32 {
  if (x > 0) {
    return 1;
  } else if (x < 0) {
    return -1;
  } else {
    return 0;
  }
}
