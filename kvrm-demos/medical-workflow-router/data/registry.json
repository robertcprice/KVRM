{
  "registry_name": "medical-workflow-router",
  "version": "1.2.0",
  "required_features": [
    "age_bracket",
    "acuity_score",
    "fever_bucket",
    "hypotension",
    "focal_neuro_deficit",
    "chest_pain",
    "respiratory_distress",
    "infection_risk",
    "symptom_onset",
    "clinician_note_flag"
  ],
  "context_schema": {
    "age_bracket": {
      "type": "string",
      "enum": [
        "pediatric",
        "adult",
        "older_adult"
      ]
    },
    "acuity_score": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "fever_bucket": {
      "type": "string",
      "enum": [
        "none",
        "mild",
        "high"
      ]
    },
    "hypotension": {
      "type": "boolean"
    },
    "focal_neuro_deficit": {
      "type": "boolean"
    },
    "chest_pain": {
      "type": "boolean"
    },
    "respiratory_distress": {
      "type": "boolean"
    },
    "infection_risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "symptom_onset": {
      "type": "string",
      "enum": [
        "sudden",
        "progressive",
        "unclear"
      ]
    },
    "clinician_note_flag": {
      "type": "string",
      "enum": [
        "none",
        "sepsis_concern",
        "stroke_concern",
        "cardiac_concern",
        "complex"
      ]
    }
  },
  "actions": [
    {
      "action_id": "routine_review",
      "name": "Routine Review",
      "description": "Route to standard clinician review with no emergency pathway.",
      "parameters_schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "support_spec": {
        "all": [
          {
            "feature": "acuity_score",
            "op": "in",
            "value": [
              "low",
              "moderate"
            ]
          },
          {
            "feature": "fever_bucket",
            "op": "eq",
            "value": "none"
          },
          {
            "feature": "infection_risk",
            "op": "eq",
            "value": "low"
          },
          {
            "feature": "focal_neuro_deficit",
            "op": "eq",
            "value": false
          },
          {
            "feature": "chest_pain",
            "op": "eq",
            "value": false
          },
          {
            "feature": "respiratory_distress",
            "op": "eq",
            "value": false
          },
          {
            "feature": "hypotension",
            "op": "eq",
            "value": false
          },
          {
            "feature": "clinician_note_flag",
            "op": "eq",
            "value": "none"
          }
        ]
      },
      "tags": [
        "routine"
      ]
    },
    {
      "action_id": "urgent_clinician_review",
      "name": "Urgent Clinician Review",
      "description": "Immediate clinician review when acuity is high but no narrow protocol dominates.",
      "parameters_schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "support_spec": {
        "all": [
          {
            "feature": "acuity_score",
            "op": "in",
            "value": [
              "high",
              "critical"
            ]
          },
          {
            "feature": "clinician_note_flag",
            "op": "in",
            "value": [
              "none",
              "complex"
            ]
          },
          {
            "feature": "focal_neuro_deficit",
            "op": "eq",
            "value": false
          },
          {
            "feature": "chest_pain",
            "op": "eq",
            "value": false
          },
          {
            "feature": "respiratory_distress",
            "op": "eq",
            "value": false
          },
          {
            "feature": "hypotension",
            "op": "eq",
            "value": false
          },
          {
            "not": {
              "any": [
                {
                  "all": [
                    {
                      "feature": "focal_neuro_deficit",
                      "op": "eq",
                      "value": true
                    },
                    {
                      "feature": "symptom_onset",
                      "op": "eq",
                      "value": "sudden"
                    }
                  ]
                },
                {
                  "all": [
                    {
                      "feature": "infection_risk",
                      "op": "eq",
                      "value": "high"
                    },
                    {
                      "feature": "fever_bucket",
                      "op": "eq",
                      "value": "high"
                    },
                    {
                      "any": [
                        {
                          "feature": "hypotension",
                          "op": "eq",
                          "value": true
                        },
                        {
                          "feature": "respiratory_distress",
                          "op": "eq",
                          "value": true
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "tags": [
        "urgent"
      ]
    },
    {
      "action_id": "sepsis_screen_pathway",
      "name": "Sepsis Screen Pathway",
      "description": "Activate the sepsis-screen workflow.",
      "parameters_schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "support_spec": {
        "all": [
          {
            "feature": "infection_risk",
            "op": "eq",
            "value": "high"
          },
          {
            "feature": "fever_bucket",
            "op": "eq",
            "value": "high"
          },
          {
            "feature": "acuity_score",
            "op": "in",
            "value": [
              "high",
              "critical"
            ]
          },
          {
            "any": [
              {
                "feature": "hypotension",
                "op": "eq",
                "value": true
              },
              {
                "feature": "respiratory_distress",
                "op": "eq",
                "value": true
              },
              {
                "feature": "clinician_note_flag",
                "op": "eq",
                "value": "sepsis_concern"
              }
            ]
          }
        ]
      },
      "tags": [
        "critical_pathway"
      ]
    },
    {
      "action_id": "stroke_alert_pathway",
      "name": "Stroke Alert Pathway",
      "description": "Activate the stroke-alert workflow.",
      "parameters_schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "support_spec": {
        "all": [
          {
            "feature": "focal_neuro_deficit",
            "op": "eq",
            "value": true
          },
          {
            "feature": "symptom_onset",
            "op": "eq",
            "value": "sudden"
          },
          {
            "feature": "acuity_score",
            "op": "in",
            "value": [
              "high",
              "critical"
            ]
          },
          {
            "any": [
              {
                "feature": "clinician_note_flag",
                "op": "eq",
                "value": "stroke_concern"
              },
              {
                "feature": "age_bracket",
                "op": "in",
                "value": [
                  "adult",
                  "older_adult"
                ]
              }
            ]
          }
        ]
      },
      "tags": [
        "critical_pathway"
      ]
    },
    {
      "action_id": "cardiac_chest_pain_pathway",
      "name": "Cardiac Chest Pain Pathway",
      "description": "Route to the chest-pain cardiac workflow.",
      "parameters_schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "support_spec": {
        "all": [
          {
            "feature": "chest_pain",
            "op": "eq",
            "value": true
          },
          {
            "feature": "acuity_score",
            "op": "in",
            "value": [
              "high",
              "critical"
            ]
          },
          {
            "feature": "focal_neuro_deficit",
            "op": "eq",
            "value": false
          },
          {
            "any": [
              {
                "feature": "clinician_note_flag",
                "op": "eq",
                "value": "cardiac_concern"
              },
              {
                "feature": "age_bracket",
                "op": "eq",
                "value": "older_adult"
              }
            ]
          }
        ]
      },
      "tags": [
        "critical_pathway"
      ]
    },
    {
      "action_id": "respiratory_support_pathway",
      "name": "Respiratory Support Pathway",
      "description": "Route to the respiratory-support workflow.",
      "parameters_schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "support_spec": {
        "all": [
          {
            "feature": "respiratory_distress",
            "op": "eq",
            "value": true
          },
          {
            "feature": "acuity_score",
            "op": "in",
            "value": [
              "high",
              "critical"
            ]
          },
          {
            "feature": "focal_neuro_deficit",
            "op": "eq",
            "value": false
          },
          {
            "feature": "chest_pain",
            "op": "eq",
            "value": false
          },
          {
            "not": {
              "all": [
                {
                  "feature": "infection_risk",
                  "op": "eq",
                  "value": "high"
                },
                {
                  "feature": "fever_bucket",
                  "op": "eq",
                  "value": "high"
                }
              ]
            }
          }
        ]
      },
      "tags": [
        "critical_pathway"
      ]
    },
    {
      "action_id": "lab_panel_priority_order",
      "name": "Lab Panel Priority Order",
      "description": "Queue priority lab workup without emergency activation.",
      "parameters_schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "support_spec": {
        "all": [
          {
            "feature": "acuity_score",
            "op": "eq",
            "value": "moderate"
          },
          {
            "feature": "infection_risk",
            "op": "in",
            "value": [
              "medium",
              "high"
            ]
          },
          {
            "feature": "fever_bucket",
            "op": "in",
            "value": [
              "mild",
              "high"
            ]
          },
          {
            "feature": "hypotension",
            "op": "eq",
            "value": false
          },
          {
            "feature": "focal_neuro_deficit",
            "op": "eq",
            "value": false
          }
        ]
      },
      "tags": [
        "workup"
      ]
    },
    {
      "action_id": "escalate_supervisor_review",
      "name": "Escalate Supervisor Review",
      "description": "Escalate to supervising clinician when signals are ambiguous or unsupported for automation.",
      "parameters_schema": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "required": []
      },
      "support_spec": {
        "any": [
          {
            "all": [
              {
                "feature": "focal_neuro_deficit",
                "op": "eq",
                "value": true
              },
              {
                "feature": "chest_pain",
                "op": "eq",
                "value": true
              },
              {
                "feature": "clinician_note_flag",
                "op": "eq",
                "value": "complex"
              }
            ]
          },
          {
            "all": [
              {
                "feature": "respiratory_distress",
                "op": "eq",
                "value": true
              },
              {
                "feature": "hypotension",
                "op": "eq",
                "value": true
              },
              {
                "feature": "acuity_score",
                "op": "eq",
                "value": "critical"
              },
              {
                "feature": "clinician_note_flag",
                "op": "eq",
                "value": "complex"
              }
            ]
          }
        ]
      },
      "tags": [
        "fallback",
        "safe"
      ]
    }
  ]
}
